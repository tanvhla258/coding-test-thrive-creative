meta {
  name: Create Customer Note
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/customers/cust_001/notes
  body: json
  auth: inherit
}

body:json {
  {
    "text": "Customer called about their order status",
    "author": "John Doe"
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });

  test("should return created note", function() {
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.have.property("id");
    expect(res.body.data).to.have.property("customerId");
    expect(res.body.data).to.have.property("text");
    expect(res.body.data).to.have.property("author");
    expect(res.body.data).to.have.property("createdAt");
  });
}
