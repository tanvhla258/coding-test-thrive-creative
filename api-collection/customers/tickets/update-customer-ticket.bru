meta {
  name: Update Customer Ticket
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/customers/cust_001/tickets/ticket_001
  body: json
  auth: inherit
}

body:json {
  {
    "statusId": "status_2",
    "subject": "Updated ticket subject"
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return updated ticket", function() {
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.have.property("id");
    expect(res.body.data).to.have.property("statusId");
    expect(res.body.data).to.have.property("status");
  });
}
