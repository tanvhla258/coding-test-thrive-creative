meta {
  name: Create Note - Missing Fields
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/notes
  body: json
  auth: inherit
}

body:json {
  {
    "customerId": "cust_001"
  }
}

tests {
  test("should return 400", function() {
    expect(res.status).to.equal(400);
  });

  test("should return validation error", function() {
    expect(res.body).to.have.property("success", false);
    expect(res.body).to.have.property("error");
  });
}
