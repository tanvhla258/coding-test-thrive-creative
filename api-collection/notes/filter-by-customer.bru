meta {
  name: Filter Notes by Customer ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/notes?customerId=cust_001
  body: none
  auth: inherit
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return filtered notes", function() {
    expect(res.body).to.be.an("array");
    res.body.forEach(function(note) {
      expect(note.customerId).to.equal("cust_001");
    });
  });
}
